{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canary Metrics Schema",
  "type": "object",
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "window": { "type": "string", "enum": ["5m", "15m"] },
    "latency": {
      "type": "object",
      "properties": {
        "p50_ms": { "type": "number" },
        "p95_ms": { "type": "number" },
        "p99_ms": { "type": "number" }
      },
      "required": ["p50_ms", "p95_ms", "p99_ms"]
    },
    "error_rate_percent": { "type": "number" },
    "throughput_rps": { "type": "number" },
    "resources": {
      "type": "object",
      "properties": {
        "cpu_percent": { "type": "number" },
        "mem_percent": { "type": "number" },
        "redis_status": { "type": "string", "enum": ["ok", "degraded", "down"] }
      },
      "required": ["cpu_percent", "mem_percent", "redis_status"]
    },
    "business": {
      "type": "object",
      "properties": {
        "active_sessions": { "type": "number" },
        "messages_per_min": { "type": "number" },
        "workflow_creations": { "type": "number" }
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "critical"]
          },
          "message": { "type": "string" }
        },
        "required": ["type", "severity", "message"]
      }
    }
  },
  "required": [
    "timestamp",
    "window",
    "latency",
    "error_rate_percent",
    "throughput_rps",
    "resources"
  ]
}
