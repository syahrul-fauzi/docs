{
  "color": {
    "primary": "#3366FF",
    "secondary": "#22CC88",
    "semantic": {
      "success": "#16A34A",
      "warning": "#F59E0B",
      "error": "#DC2626",
      "info": "#0EA5E9"
    }
  },
  "typography": {
    "fontFamilies": { "base": "Inter", "mono": "JetBrains Mono" },
    "sizes": { "xs": 12, "sm": 14, "md": 16, "lg": 18, "xl": 24 },
    "weights": { "regular": 400, "medium": 500, "bold": 700 },
    "lineHeight": { "sm": 1.4, "md": 1.6, "lg": 1.8 }
  },
  "spacing": {
    "scale": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24 }
  },
  "radius": { "sm": 4, "md": 8, "lg": 12 },
  "shadow": {
    "sm": "0 1px 2px rgba(0,0,0,0.08)",
    "md": "0 2px 6px rgba(0,0,0,0.12)",
    "lg": "0 4px 12px rgba(0,0,0,0.16)"
  },
  "zIndex": { "dropdown": 1000, "modal": 1100, "toast": 1200 }
}
