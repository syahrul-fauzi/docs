{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Supplier Onboarding Capability",
  "description": "Schema for automating the registration and verification of new suppliers",
  "type": "object",
  "required": ["tenantId", "supplierInfo"],
  "properties": {
    "tenantId": {
      "type": "string"
    },
    "supplierInfo": {
      "type": "object",
      "required": ["companyName", "taxId", "email"],
      "properties": {
        "companyName": { "type": "string" },
        "taxId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "address": { "type": "string" },
        "category": { "type": "string" }
      }
    },
    "verificationLevel": {
      "type": "string",
      "enum": ["basic", "standard", "enhanced"],
      "default": "standard"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
