{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Internal Knowledge Search Capability",
  "description": "Schema for searching information within tenant's internal knowledge base",
  "type": "object",
  "required": ["tenantId", "query"],
  "properties": {
    "tenantId": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "topK": {
      "type": "integer",
      "default": 5,
      "minimum": 1
    },
    "similarityThreshold": {
      "type": "number",
      "default": 0.7,
      "minimum": 0,
      "maximum": 1
    },
    "filters": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Metadata filters for retrieval (e.g., { 'department': 'HR' })"
    }
  }
}
