{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Marketing Lead Collect Capability",
  "description": "Schema for capturing and validating marketing leads",
  "type": "object",
  "required": ["tenantId", "leadInfo"],
  "properties": {
    "tenantId": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": ["web_form", "landing_page", "manual_entry", "api_integration"],
      "default": "web_form"
    },
    "leadInfo": {
      "type": "object",
      "required": ["email", "fullName"],
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "fullName": {
          "type": "string",
          "minLength": 2
        },
        "phoneNumber": {
          "type": "string",
          "pattern": "^\\+?[1-9]\\d{1,14}$"
        },
        "companyName": {
          "type": "string"
        },
        "jobTitle": {
          "type": "string"
        }
      }
    },
    "consent": {
      "type": "boolean",
      "description": "User consent for marketing communications"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
