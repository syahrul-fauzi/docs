  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Setup headers via variables if needed",
          "pm.variables.set('Authorization', `Bearer ${pm.environment.get('jwt')}`);"
        ],
        "type": "text/javascript"
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          "// Performance report generation (mean, p95, p99)",
          "const arr = (pm.environment.get('resp_times') || '').split(',').filter(x=>x).map(Number);",
          "function percentile(a, p){ if(a.length===0) return 0; const s=[...a].sort((x,y)=>x-y); const idx=Math.ceil((p/100)*s.length)-1; return s[Math.max(0,Math.min(idx,s.length-1))]; }",
          "const sum = arr.reduce((t,x)=>t+x,0); const mean = arr.length? (sum/arr.length):0;",
          "const p95 = percentile(arr,95); const p99 = percentile(arr,99);",
          "console.log('PerfReport', {mean, p95, p99, samples: arr.length});",
          "pm.environment.set('perf_mean', mean);",
          "pm.environment.set('perf_p95', p95);",
          "pm.environment.set('perf_p99', p99);"
        ],
        "type": "text/javascript"
      }
    }
